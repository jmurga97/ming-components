    },
    "./tag-list": {
      "types": "./dist/tag_list.d.ts",
      "import": "./dist/tag_list.js"
    },
    "./tag-picker": {
      "types": "./dist/tag_picker.d.ts",
      "import": "./dist/tag_picker.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "lint": "bun run lint:prettier && bun run lint:eslint",
    "lint:prettier": "prettier --check .",
    "lint:eslint": "eslint .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "package:check": "bun run build && publint && bun scripts/check_package.ts",
    "prepublishOnly": "bun run lint && bun run check && bun run test && bun run package:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.55.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
