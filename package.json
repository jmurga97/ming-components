      "types": "./dist/search_field.d.ts",
      "import": "./dist/search_field.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js"
    },
    "./sidebar-nav": {
      "types": "./dist/sidebar_nav.d.ts",
      "import": "./dist/sidebar_nav.js"
    },
    "./status-region": {
      "types": "./dist/status_region.d.ts",
      "import": "./dist/status_region.js"
    },
