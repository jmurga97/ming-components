    },
    "./app-shell": {
      "types": "./dist/app_shell.d.ts",
      "import": "./dist/app_shell.js"
    },
    "./resource-table": {
      "types": "./dist/resource_table.d.ts",
      "import": "./dist/resource_table.js"
    },
    "./bulk-actions": {
      "types": "./dist/bulk_actions.d.ts",
      "import": "./dist/bulk_actions.js"
    },
    "./media-browser": {
      "types": "./dist/media_browser.d.ts",
      "import": "./dist/media_browser.js"
    },
    "./overview-panel": {
      "types": "./dist/overview_panel.d.ts",
      "import": "./dist/overview_panel.js"
    },
    "./relationship-panel": {
      "types": "./dist/relationship_panel.d.ts",
